# HTTP server port
PORT=3000

# Runtime environment: development | production | test
NODE_ENV=development

# Log verbosity: debug | info | warn | error
LOG_LEVEL=info

# Set to false to disable the /metrics endpoint
METRICS_ENABLED=true

# Set to false in production to disable all /api/v1/admin/* chaos endpoints
CHAOS_ENABLED=true

# How long (ms) to return 503 on /ready after startup
STARTUP_GRACE_MS=5000

# Max time (ms) to wait for in-flight requests before force-exiting on SIGTERM
SHUTDOWN_TIMEOUT_MS=10000

# Injected at build time by CI — do not set manually
VERSION=1.0.0
COMMIT=unknown
BUILD_TIME=
